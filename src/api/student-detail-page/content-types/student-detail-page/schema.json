{
  "kind": "collectionType",
  "collectionName": "student_detail_pages",
  "info": {
    "singularName": "student-detail-page",
    "pluralName": "student-detail-pages",
    "displayName": "Student detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "P5": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "javascript"
      }
    },
    "LesJaar": {
      "type": "integer",
      "default": 26,
      "min": 0,
      "max": 99
    },
    "ProjectTitel": {
      "type": "string",
      "minLength": 2,
      "required": true
    },
    "ProjectBeschrijving": {
      "type": "string"
    },
    "AantalStudenten": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "Opleiding": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[-]",
      "options": [
        "HBO-ICT\t",
        "CMD\t",
        "CO\t",
        "CB\t",
        "FDND\t",
        "-"
      ]
    },
    "SchoolJaar": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "1",
        "2",
        "3",
        "4"
      ],
      "min": 1,
      "max": 4,
      "required": true
    },
    "Onderwijseenheid": {
      "type": "component",
      "component": "component.onderwijseenheid",
      "repeatable": false
    },
    "Bronnen": {
      "type": "component",
      "component": "component.bronnen",
      "repeatable": true
    },
    "Partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner",
      "mappedBy": "student_detail_page"
    },
    "Niveau": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Bachelor",
        "Master",
        "AD"
      ],
      "max": 1,
      "min": 1
    },
    "Slug": {
      "type": "uid",
      "targetField": "ProjectTitel",
      "required": true
    },
    "Doorlooptijd": {
      "type": "string"
    },
    "Foto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Audio": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "audios"
      ]
    },
    "VideoEmbed": {
      "type": "string"
    }
  }
}
