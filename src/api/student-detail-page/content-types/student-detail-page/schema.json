{
  "kind": "collectionType",
  "collectionName": "student_detail_pages",
  "info": {
    "singularName": "student-detail-page",
    "pluralName": "student-detail-pages",
    "displayName": "Student detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ProjectTitel": {
      "type": "string",
      "minLength": 2,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "ProjectTitel",
      "required": true
    },
    "ProjectBeschrijving": {
      "type": "string"
    },
    "LesJaar": {
      "type": "integer",
      "default": 26,
      "min": 0,
      "max": 99
    },
    "AantalStudenten": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "SchoolJaar": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "1",
        "2",
        "3",
        "4"
      ],
      "min": 1,
      "max": 4,
      "required": true
    },
    "Bronnen": {
      "type": "component",
      "component": "component.bronnen",
      "repeatable": true
    },
    "partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner",
      "mappedBy": "student_detail_page"
    },
    "Onderwijseenheid": {
      "type": "component",
      "component": "component.onderwijseenheid",
      "repeatable": false
    },
    "Niveau": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Bachelor",
        "Master",
        "AD"
      ],
      "max": 1,
      "min": 1
    }
  }
}
