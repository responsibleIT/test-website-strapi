{
  "kind": "collectionType",
  "collectionName": "research_detail_pages",
  "info": {
    "singularName": "research-detail-page",
    "pluralName": "research-detail-pages",
    "displayName": "Research detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Jaar": {
      "type": "integer"
    },
    "ProjectTitle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "ProjectBeschrijving": {
      "type": "text"
    },
    "Regeling": {
      "type": "string"
    },
    "Bronnen": {
      "type": "component",
      "component": "component.bronnen",
      "repeatable": true
    },
    "Url": {
      "type": "string"
    },
    "Slug": {
      "type": "uid",
      "required": true
    },
    "Duur": {
      "type": "integer"
    },
    "Foto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Audio": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "audios"
      ]
    },
    "VideoEmbed": {
      "type": "string"
    },
    "partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner",
      "mappedBy": "research_detail_pages"
    }
  }
}
